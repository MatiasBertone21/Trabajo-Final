# ==========================================
# Vision Service Environment Configuration Example
# ==========================================

# Base URL of the vision microservice (without trailing slash)
VISION_API_URL=http://localhost:8001/api/vision

# OCR Engine to use: easyocr | tesseract
VISION_OCR_ENGINE=easyocr

# EasyOCR languages (comma-separated, e.g. en,es)
VISION_OCR_LANGUAGES=en,es
